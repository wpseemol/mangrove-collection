# Mangrove Collection storefront: Next.js static export on Apache (cPanel).
# Next copies this file into out/. Upload the contents of out/ to the
# document root of mangrove-collection.com (usually public_html).

Options -Indexes -MultiViews
DirectoryIndex index.html
ServerSignature Off
# trailingSlash: true -> /shop is served from /shop/index.html; Apache adds the slash
# with a 301 and keeps the query string (e.g. /reset-password?token=...).
DirectorySlash On
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Always HTTPS (the session cookie is Secure-only in production).
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !=https
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # One canonical host: www -> apex. Remove these two lines if you prefer www.
    RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
    RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

    # Never serve dotfiles (except ACME challenges for SSL certificates).
    RewriteRule (^|/)\.(?!well-known/) - [F,L]
</IfModule>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), usb=()"
    # Allows the Google sign-in popup to report back to this window.
    Header always set Cross-Origin-Opener-Policy "same-origin-allow-popups"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=HTTPS
    # Scripts are not restricted because admins can add analytics/pixel snippets from the
    # dashboard; everything else that matters for clickjacking and injection is locked down.
    Header always set Content-Security-Policy "frame-ancestors 'self'; base-uri 'self'; object-src 'none'; form-action 'self'; upgrade-insecure-requests"
    Header unset X-Powered-By

    # HTML must always be revalidated so a new deploy is picked up immediately.
    <FilesMatch "\.(html|txt)$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
    # Next's hashed bundles never change, so browsers may keep them for a year.
    <If "%{REQUEST_URI} =~ m#^/_next/static/#">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </If>
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_mime.c>
    AddType application/javascript .js .mjs
    AddType image/webp .webp
    AddType font/woff2 .woff2
</IfModule>
