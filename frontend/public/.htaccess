# Mangrove Collection storefront: static Next.js export on Apache (cPanel).
# Next copies this file into out/, which is deployed to public_html.

Options -Indexes -MultiViews
DirectoryIndex index.html
ServerSignature Off
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Always HTTPS (the session cookie is Secure-only in production).
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !=https
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # www -> apex.
    RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
    RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

    # Never serve dotfiles (except ACME challenges for SSL certificates).
    RewriteRule (^|/)\.(?!well-known/) - [F,L]

    # Old blog links: /blog/post/?slug=x -> /blog/x/ and /blog/?category=x -> /blog/category/x/
    RewriteCond %{QUERY_STRING} (^|&)slug=([^&]+)
    RewriteRule ^blog/post/?$ /blog/%2/? [L,R=301]
    RewriteCond %{QUERY_STRING} (^|&)category=([^&]+)
    RewriteRule ^blog/?$ /blog/category/%2/? [L,R=301]
</IfModule>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), usb=()"
    # Allows the Google sign-in popup to report back to this window.
    Header always set Cross-Origin-Opener-Policy "same-origin-allow-popups"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=HTTPS
    # Scripts are not restricted because admins can add analytics/pixel snippets from the dashboard.
    Header always set Content-Security-Policy "frame-ancestors 'self'; base-uri 'self'; object-src 'none'; form-action 'self'; upgrade-insecure-requests"
    Header unset X-Powered-By

    # Pages must always be revalidated so a new deploy is picked up immediately.
    <FilesMatch "\.(html|txt)$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
    # Next's hashed bundles never change, so browsers may keep them for a year.
    <If "%{REQUEST_URI} =~ m#^/_next/static/#">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </If>
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>

<IfModule mod_mime.c>
    AddType application/javascript .js .mjs
    AddType image/webp .webp
    AddType application/manifest+json .webmanifest
</IfModule>
