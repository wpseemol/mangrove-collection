# Baked into the static bundle at build time (`pnpm build` -> out/). Never put secrets here.
# The API, storefront and dashboard must share one registrable domain so the
# HttpOnly session cookie (SESSION_DOMAIN=.mangrove-collection.com) reaches the API.
NEXT_PUBLIC_API_URL=https://api.mangrove-collection.com/v1
NEXT_PUBLIC_SITE_URL=https://mangrove-collection.com
# Staff (admin/manager) who sign in on the storefront are sent here, already signed in.
NEXT_PUBLIC_DASHBOARD_URL=https://dashboard.mangrove-collection.com
