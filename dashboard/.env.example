# Baked into the static bundle at build time (`pnpm build` -> dist/). Never put secrets here.
# The API, storefront and dashboard must share one registrable domain so the
# HttpOnly session cookie (SESSION_DOMAIN=.mangrove-collection.com) reaches the API.
VITE_API_URL=https://api.mangrove-collection.com/v1
VITE_STOREFRONT_URL=https://mangrove-collection.com
