generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "mysql"
}

model User {
  id                BigInt           @id @default(autoincrement()) @db.UnsignedBigInt
  name              String           @db.VarChar(255)
  email             String           @unique(map: "users_email_unique") @db.VarChar(255)
  phone             String?          @unique(map: "users_phone_unique") @db.VarChar(32)
  avatar            String?          @db.VarChar(255)
  role              String           @default("customer") @db.VarChar(20)
  is_active         Boolean          @default(true)
  google_id         String?          @unique(map: "users_google_id_unique") @db.VarChar(255)
  email_verified_at DateTime?        @db.Timestamp(0)
  password          String?          @db.VarChar(255)
  remember_token    String?          @db.VarChar(100)
  last_login_at     DateTime?        @db.Timestamp(0)
  created_at        DateTime?        @default(now()) @db.Timestamp(0)
  updated_at        DateTime?        @updatedAt @db.Timestamp(0)
  addresses         Address[]
  categories        Category[]
  media             Media[]
  orders            Order[]
  paymentAccounts   PaymentAccount[]
  reviewedPayments  Payment[]
  reviews           ProductReview[]
  products          Product[]

  @@index([role], map: "users_role_index")
  @@map("users")
}

model PasswordResetToken {
  email      String    @id @db.VarChar(255)
  token      String    @db.VarChar(255)
  created_at DateTime? @db.Timestamp(0)

  @@map("password_reset_tokens")
}

model Session {
  id            String  @id @db.VarChar(255)
  user_id       BigInt? @db.UnsignedBigInt
  ip_address    String? @db.VarChar(45)
  user_agent    String? @db.Text
  payload       String  @db.LongText
  last_activity Int

  @@index([last_activity], map: "sessions_last_activity_index")
  @@index([user_id], map: "sessions_user_id_index")
  @@map("sessions")
}

model Setting {
  id           BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  group        String    @db.VarChar(50)
  key          String    @unique(map: "settings_key_unique") @db.VarChar(100)
  value        String?   @db.LongText
  type         String    @default("string") @db.VarChar(20)
  is_public    Boolean   @default(false)
  is_encrypted Boolean   @default(false)
  created_at   DateTime? @default(now()) @db.Timestamp(0)
  updated_at   DateTime? @updatedAt @db.Timestamp(0)

  @@index([group], map: "settings_group_index")
  @@map("settings")
}

model Address {
  id           BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  user_id      BigInt    @db.UnsignedBigInt
  label        String?   @db.VarChar(50)
  name         String    @db.VarChar(255)
  email        String?   @db.VarChar(255)
  phone        String    @db.VarChar(32)
  region       String?   @db.VarChar(255)
  city         String?   @db.VarChar(255)
  zone         String?   @db.VarChar(255)
  landmark     String?   @db.VarChar(255)
  full_address String    @db.Text
  is_default   Boolean   @default(false)
  created_at   DateTime? @default(now()) @db.Timestamp(0)
  updated_at   DateTime? @updatedAt @db.Timestamp(0)
  user         User      @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "addresses_user_id_foreign")

  @@index([user_id], map: "addresses_user_id_foreign")
  @@map("addresses")
}

model Banner {
  id           BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  type         String    @default("slide") @db.VarChar(20)
  title        String?   @db.VarChar(255)
  subtitle     String?   @db.VarChar(255)
  image        String    @db.VarChar(255)
  link_url     String?   @db.VarChar(255)
  link_enabled Boolean   @default(false)
  is_active    Boolean   @default(true)
  sort_order   Int       @default(0) @db.UnsignedInt
  created_at   DateTime? @default(now()) @db.Timestamp(0)
  updated_at   DateTime? @updatedAt @db.Timestamp(0)

  @@index([type], map: "banners_type_index")
  @@map("banners")
}

model Category {
  id          BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  name        String    @db.VarChar(255)
  slug        String    @unique(map: "categories_slug_unique") @db.VarChar(255)
  image       String?   @db.VarChar(255)
  icon        String?   @db.VarChar(64)
  description String?   @db.Text
  is_active   Boolean   @default(true)
  sort_order  Int       @default(0) @db.UnsignedInt
  created_by  BigInt?   @db.UnsignedBigInt
  created_at  DateTime? @default(now()) @db.Timestamp(0)
  updated_at  DateTime? @updatedAt @db.Timestamp(0)
  creator     User?     @relation(fields: [created_by], references: [id], onUpdate: NoAction, map: "categories_created_by_foreign")
  products    Product[]

  @@index([created_by], map: "categories_created_by_foreign")
  @@map("categories")
}

model Media {
  id            BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  disk          String    @db.VarChar(30)
  path          String    @db.VarChar(255)
  original_name String    @db.VarChar(255)
  mime_type     String    @db.VarChar(100)
  size          BigInt    @db.UnsignedBigInt
  uploaded_by   BigInt?   @db.UnsignedBigInt
  created_at    DateTime? @default(now()) @db.Timestamp(0)
  updated_at    DateTime? @updatedAt @db.Timestamp(0)
  uploader      User?     @relation(fields: [uploaded_by], references: [id], onUpdate: NoAction, map: "media_uploaded_by_foreign")

  @@index([uploaded_by], map: "media_uploaded_by_foreign")
  @@map("media")
}

model Page {
  id               BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  slug             String    @unique(map: "pages_slug_unique") @db.VarChar(255)
  title            String    @db.VarChar(255)
  content          String?   @db.LongText
  sections         Json?
  meta_title       String?   @db.VarChar(255)
  meta_description String?   @db.VarChar(500)
  is_published     Boolean   @default(true)
  created_at       DateTime? @default(now()) @db.Timestamp(0)
  updated_at       DateTime? @updatedAt @db.Timestamp(0)

  @@map("pages")
}

model NewsletterSubscriber {
  id              BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  email           String    @unique(map: "newsletter_subscribers_email_unique") @db.VarChar(255)
  status          String    @default("subscribed") @db.VarChar(20)
  source          String?   @db.VarChar(50)
  ip_address      String?   @db.VarChar(45)
  unsubscribed_at DateTime? @db.Timestamp(0)
  created_at      DateTime? @default(now()) @db.Timestamp(0)
  updated_at      DateTime? @updatedAt @db.Timestamp(0)

  @@index([status], map: "newsletter_subscribers_status_index")
  @@map("newsletter_subscribers")
}

model ShippingMethod {
  id          BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  code        String    @unique(map: "shipping_methods_code_unique") @db.VarChar(50)
  title       String    @db.VarChar(255)
  description String?   @db.VarChar(255)
  price       Decimal   @db.Decimal(12, 2)
  is_active   Boolean   @default(true)
  sort_order  Int       @default(0) @db.UnsignedInt
  created_at  DateTime? @default(now()) @db.Timestamp(0)
  updated_at  DateTime? @updatedAt @db.Timestamp(0)
  orders      Order[]

  @@map("shipping_methods")
}

model Product {
  id                BigInt           @id @default(autoincrement()) @db.UnsignedBigInt
  category_id       BigInt           @db.UnsignedBigInt
  name              String           @db.VarChar(255)
  slug              String           @unique(map: "products_slug_unique") @db.VarChar(255)
  unit              String?          @db.VarChar(50)
  size              String?          @db.VarChar(100)
  shipping_cost     Decimal?         @db.Decimal(10, 2)
  currency          String           @default("BDT") @db.VarChar(3)
  short_description String?          @db.VarChar(500)
  description       String?          @db.LongText
  thumbnail         String?          @db.VarChar(255)
  tags              Json?
  status            String           @default("draft") @db.VarChar(20)
  is_featured       Boolean          @default(false)
  popularity        Int              @default(0) @db.UnsignedInt
  rating_avg        Decimal          @default(0.00) @db.Decimal(3, 2)
  rating_count      Int              @default(0) @db.UnsignedInt
  meta_title        String?          @db.VarChar(255)
  meta_description  String?          @db.VarChar(500)
  created_by        BigInt?          @db.UnsignedBigInt
  created_at        DateTime?        @default(now()) @db.Timestamp(0)
  updated_at        DateTime?        @updatedAt @db.Timestamp(0)
  deleted_at        DateTime?        @db.Timestamp(0)
  orderItems        OrderItem[]
  images            ProductImage[]
  reviews           ProductReview[]
  variants          ProductVariant[]
  category          Category         @relation(fields: [category_id], references: [id], onUpdate: NoAction, map: "products_category_id_foreign")
  creator           User?            @relation(fields: [created_by], references: [id], onUpdate: NoAction, map: "products_created_by_foreign")

  @@index([category_id], map: "products_category_id_foreign")
  @@index([created_by], map: "products_created_by_foreign")
  @@index([is_featured], map: "products_is_featured_index")
  @@index([status], map: "products_status_index")
  @@map("products")
}

model ProductVariant {
  id            BigInt      @id @default(autoincrement()) @db.UnsignedBigInt
  product_id    BigInt      @db.UnsignedBigInt
  title         String      @db.VarChar(255)
  type          String?     @db.VarChar(50)
  sku           String?     @unique(map: "product_variants_sku_unique") @db.VarChar(100)
  price         Decimal     @db.Decimal(12, 2)
  compare_price Decimal?    @db.Decimal(12, 2)
  stock         Int?        @db.UnsignedInt
  is_default    Boolean     @default(false)
  sort_order    Int         @default(0) @db.UnsignedInt
  created_at    DateTime?   @default(now()) @db.Timestamp(0)
  updated_at    DateTime?   @updatedAt @db.Timestamp(0)
  orderItems    OrderItem[]
  product       Product     @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "product_variants_product_id_foreign")

  @@index([product_id], map: "product_variants_product_id_foreign")
  @@map("product_variants")
}

model ProductImage {
  id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  product_id BigInt    @db.UnsignedBigInt
  url        String    @db.VarChar(255)
  alt        String?   @db.VarChar(255)
  sort_order Int       @default(0) @db.UnsignedInt
  created_at DateTime? @default(now()) @db.Timestamp(0)
  updated_at DateTime? @updatedAt @db.Timestamp(0)
  product    Product   @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "product_images_product_id_foreign")

  @@index([product_id], map: "product_images_product_id_foreign")
  @@map("product_images")
}

model ProductReview {
  id             BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  product_id     BigInt    @db.UnsignedBigInt
  order_id       BigInt?   @db.UnsignedBigInt
  user_id        BigInt?   @db.UnsignedBigInt
  reviewer_name  String    @db.VarChar(100)
  reviewer_phone String?   @db.VarChar(20)
  reviewer_email String?   @db.VarChar(255)
  rating         Int       @db.UnsignedTinyInt
  comment        String    @db.Text
  images         Json?
  status         String    @default("published") @db.VarChar(20)
  edited_at      DateTime? @db.Timestamp(0)
  created_at     DateTime? @default(now()) @db.Timestamp(0)
  updated_at     DateTime? @updatedAt @db.Timestamp(0)
  order          Order?    @relation(fields: [order_id], references: [id], onUpdate: NoAction, map: "product_reviews_order_id_foreign")
  product        Product   @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "product_reviews_product_id_foreign")
  user           User?     @relation(fields: [user_id], references: [id], onUpdate: NoAction, map: "product_reviews_user_id_foreign")

  @@unique([product_id, order_id], map: "product_reviews_product_id_order_id_unique")
  @@index([order_id], map: "product_reviews_order_id_foreign")
  @@index([product_id, status, created_at], map: "product_reviews_product_id_status_created_at_index")
  @@index([reviewer_email], map: "product_reviews_reviewer_email_index")
  @@index([reviewer_phone], map: "product_reviews_reviewer_phone_index")
  @@index([user_id], map: "product_reviews_user_id_foreign")
  @@map("product_reviews")
}

model Order {
  id                    BigInt          @id @default(autoincrement()) @db.UnsignedBigInt
  order_number          String          @unique(map: "orders_order_number_unique") @db.VarChar(32)
  user_id               BigInt?         @db.UnsignedBigInt
  customer_name         String          @db.VarChar(255)
  customer_email        String?         @db.VarChar(255)
  customer_phone        String          @db.VarChar(32)
  shipping_address      Json
  shipping_method_id    BigInt?         @db.UnsignedBigInt
  shipping_method_title String?         @db.VarChar(255)
  currency              String          @default("BDT") @db.VarChar(3)
  subtotal              Decimal         @db.Decimal(12, 2)
  shipping_cost         Decimal         @default(0.00) @db.Decimal(12, 2)
  discount              Decimal         @default(0.00) @db.Decimal(12, 2)
  total                 Decimal         @db.Decimal(12, 2)
  payment_method        String          @db.VarChar(20)
  payment_status        String          @default("pending") @db.VarChar(20)
  status                String          @default("pending") @db.VarChar(20)
  customer_note         String?         @db.Text
  admin_note            String?         @db.Text
  cancelled_at          DateTime?       @db.Timestamp(0)
  delivered_at          DateTime?       @db.Timestamp(0)
  created_at            DateTime?       @default(now()) @db.Timestamp(0)
  updated_at            DateTime?       @updatedAt @db.Timestamp(0)
  items                 OrderItem[]
  shippingMethod        ShippingMethod? @relation(fields: [shipping_method_id], references: [id], onUpdate: NoAction, map: "orders_shipping_method_id_foreign")
  user                  User?           @relation(fields: [user_id], references: [id], onUpdate: NoAction, map: "orders_user_id_foreign")
  payments              Payment[]
  reviews               ProductReview[]

  @@index([customer_phone], map: "orders_customer_phone_index")
  @@index([payment_status], map: "orders_payment_status_index")
  @@index([shipping_method_id], map: "orders_shipping_method_id_foreign")
  @@index([status], map: "orders_status_index")
  @@index([user_id], map: "orders_user_id_foreign")
  @@map("orders")
}

model OrderItem {
  id                 BigInt          @id @default(autoincrement()) @db.UnsignedBigInt
  order_id           BigInt          @db.UnsignedBigInt
  product_id         BigInt?         @db.UnsignedBigInt
  product_variant_id BigInt?         @db.UnsignedBigInt
  product_name       String          @db.VarChar(255)
  product_slug       String          @db.VarChar(255)
  variant_title      String?         @db.VarChar(255)
  image              String?         @db.VarChar(255)
  unit_price         Decimal         @db.Decimal(12, 2)
  quantity           Int             @db.UnsignedInt
  line_total         Decimal         @db.Decimal(12, 2)
  created_at         DateTime?       @default(now()) @db.Timestamp(0)
  updated_at         DateTime?       @updatedAt @db.Timestamp(0)
  order              Order           @relation(fields: [order_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "order_items_order_id_foreign")
  product            Product?        @relation(fields: [product_id], references: [id], onUpdate: NoAction, map: "order_items_product_id_foreign")
  variant            ProductVariant? @relation(fields: [product_variant_id], references: [id], onUpdate: NoAction, map: "order_items_product_variant_id_foreign")

  @@index([order_id], map: "order_items_order_id_foreign")
  @@index([product_id], map: "order_items_product_id_foreign")
  @@index([product_variant_id], map: "order_items_product_variant_id_foreign")
  @@map("order_items")
}

model PaymentAccount {
  id             BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  method         String    @db.VarChar(20)
  account_type   String    @default("personal") @db.VarChar(20)
  account_number String    @db.VarChar(32)
  account_name   String?   @db.VarChar(100)
  instructions   String?   @db.Text
  is_active      Boolean   @default(true)
  sort_order     Int       @default(0) @db.UnsignedInt
  created_by     BigInt?   @db.UnsignedBigInt
  created_at     DateTime? @default(now()) @db.Timestamp(0)
  updated_at     DateTime? @updatedAt @db.Timestamp(0)
  creator        User?     @relation(fields: [created_by], references: [id], onUpdate: NoAction, map: "payment_accounts_created_by_foreign")
  payments       Payment[]

  @@unique([method, account_number], map: "payment_accounts_method_account_number_unique")
  @@index([created_by], map: "payment_accounts_created_by_foreign")
  @@index([method, is_active], map: "payment_accounts_method_is_active_index")
  @@map("payment_accounts")
}

model Payment {
  id                 BigInt          @id @default(autoincrement()) @db.UnsignedBigInt
  order_id           BigInt          @db.UnsignedBigInt
  payment_account_id BigInt?         @db.UnsignedBigInt
  method             String          @db.VarChar(20)
  account_type       String?         @db.VarChar(20)
  account_number     String?         @db.VarChar(32)
  amount             Decimal         @db.Decimal(12, 2)
  currency           String          @default("BDT") @db.VarChar(3)
  sender_number      String?         @db.VarChar(32)
  transaction_id     String          @db.VarChar(32)
  status             String          @default("submitted") @db.VarChar(20)
  rejection_reason   String?         @db.VarChar(255)
  reviewed_by        BigInt?         @db.UnsignedBigInt
  reviewed_at        DateTime?       @db.Timestamp(0)
  created_at         DateTime?       @default(now()) @db.Timestamp(0)
  updated_at         DateTime?       @updatedAt @db.Timestamp(0)
  order              Order           @relation(fields: [order_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "payments_order_id_foreign")
  account            PaymentAccount? @relation(fields: [payment_account_id], references: [id], onUpdate: NoAction, map: "payments_payment_account_id_foreign")
  reviewer           User?           @relation(fields: [reviewed_by], references: [id], onUpdate: NoAction, map: "payments_reviewed_by_foreign")

  @@index([method, transaction_id], map: "payments_method_transaction_id_index")
  @@index([order_id], map: "payments_order_id_foreign")
  @@index([payment_account_id], map: "payments_payment_account_id_foreign")
  @@index([reviewed_by], map: "payments_reviewed_by_foreign")
  @@index([status], map: "payments_status_index")
  @@map("payments")
}
