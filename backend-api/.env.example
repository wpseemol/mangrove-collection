APP_NAME="Mangrove Collection API"
APP_ENV=production
# 32-byte key, base64-encoded: node -e "console.log('base64:'+require('crypto').randomBytes(32).toString('base64'))"
# Encrypts secret settings and signs cookies. Keep the existing key when migrating: changing it
# makes stored secrets (SMTP/SMS/Google) unreadable and signs everyone out.
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.mangrove-collection.com
PORT=8080
# Express "trust proxy" setting; set to the number of proxies (e.g. 1) behind a load balancer.
TRUST_PROXY=loopback

BCRYPT_ROUNDS=12
LOG_LEVEL=warning

# Either a full DATABASE_URL (mysql://user:pass@host:3306/db) or the DB_* parts.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mangrove_collection_db
DB_USERNAME=root
DB_PASSWORD=
# Database the test suite (pnpm test) recreates; its name must contain "test".
DB_TEST_DATABASE=mangrove_collection_test

# ------------------------------------------------------------------------
# Browser authentication (cookie sessions)
# The storefront, dashboard and API must share one registrable domain, e.g.
#   https://mangrove-collection.com            (storefront, static)
#   https://dashboard.mangrove-collection.com  (dashboard, static)
#   https://api.mangrove-collection.com        (this API)
# ------------------------------------------------------------------------
# Host[:port] of every first-party frontend (no scheme). Requests from these
# get the HttpOnly session cookie and CSRF protection.
STATEFUL_DOMAINS=mangrove-collection.com,www.mangrove-collection.com,dashboard.mangrove-collection.com
# Exact origins allowed to call the API with credentials (scheme + host).
CORS_ALLOWED_ORIGINS=https://mangrove-collection.com,https://www.mangrove-collection.com,https://dashboard.mangrove-collection.com
# "Keep me signed in" cookie lifetime in minutes (30 days).
AUTH_REMEMBER_MINUTES=43200

# Sessions are stored in the `sessions` table so they can be revoked
# (logout everywhere, password reset, deactivated users).
SESSION_COOKIE=mangrove_session
# Idle timeout in minutes when "keep me signed in" is not ticked.
SESSION_LIFETIME=120
# Leading dot: the cookie is shared by the storefront, dashboard and API subdomains.
SESSION_DOMAIN=.mangrove-collection.com
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

# Used only once by `pnpm db:seed` to bootstrap the first admin.
ADMIN_EMAIL=admin@mangrove-collection.com
ADMIN_PASSWORD=

# Google OAuth, SMTP, SMS gateway and SEO/pixel values are NOT configured
# here: they live in the `settings` table and are managed from the dashboard.
# These MAIL_* values are only a fallback while no SMTP host is saved there.
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
