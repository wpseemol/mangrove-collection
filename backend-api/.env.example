APP_ENV=production
# Generate once, never change: node -e "console.log('base64:'+require('crypto').randomBytes(32).toString('base64'))"
APP_KEY=
APP_URL=https://api.mangrove-collection.com
TRUST_PROXY=1

DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

STATEFUL_DOMAINS=mangrove-collection.com,www.mangrove-collection.com,dashboard.mangrove-collection.com
CORS_ALLOWED_ORIGINS=https://mangrove-collection.com,https://www.mangrove-collection.com,https://dashboard.mangrove-collection.com
SESSION_DOMAIN=.mangrove-collection.com
SESSION_SECURE_COOKIE=true

# Used once by `npm run db:seed` to create the first admin.
ADMIN_EMAIL=admin@mangrove-collection.com
ADMIN_PASSWORD=
