APP_NAME="Mangrove Collection API"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.mangrove-collection.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mangrove_db
DB_USERNAME=root
DB_PASSWORD=

# ------------------------------------------------------------------------
# Browser authentication (Sanctum SPA cookie sessions)
# The storefront, dashboard and API must share one registrable domain, e.g.
#   https://mangrove-collection.com            (storefront, static)
#   https://dashboard.mangrove-collection.com  (dashboard, static)
#   https://api.mangrove-collection.com        (this API)
# ------------------------------------------------------------------------
# Host[:port] of every first-party frontend (no scheme). Requests from these
# get the HttpOnly session cookie and CSRF protection.
SANCTUM_STATEFUL_DOMAINS=mangrove-collection.com,www.mangrove-collection.com,dashboard.mangrove-collection.com
# Exact origins allowed to call the API with credentials (scheme + host).
CORS_ALLOWED_ORIGINS=https://mangrove-collection.com,https://www.mangrove-collection.com,https://dashboard.mangrove-collection.com
# "Keep me signed in" cookie lifetime in minutes (30 days).
AUTH_REMEMBER_MINUTES=43200

# Used only once by `php artisan db:seed` to bootstrap the first admin.
ADMIN_EMAIL=admin@mangrove-collection.com
ADMIN_PASSWORD=

# Google OAuth, SMTP, SMS gateway and SEO/pixel values are NOT configured
# here: they live in the `settings` table and are managed from the dashboard.

# Sessions are stored in the `sessions` table so they can be revoked
# (logout everywhere, password reset, deactivated users).
SESSION_DRIVER=database
# Idle timeout in minutes when "keep me signed in" is not ticked.
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
# Leading dot: the cookie is shared by the storefront, dashboard and API subdomains.
SESSION_DOMAIN=.mangrove-collection.com
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
